# Optional limits. Empty or 0 = no limit (local default).
# Copy this file to .env.local to activate values.

# Max size per image, in MB
NEXT_PUBLIC_MAX_FILE_SIZE_MB=

# Max combined size for a batch, in MB
NEXT_PUBLIC_MAX_BATCH_SIZE_MB=

# Max files per batch (default 100, same as before)
NEXT_PUBLIC_MAX_FILES=100

# Requests per IP per minute. 0 = disabled
RATE_LIMIT_OPTIMIZE_PER_MIN=0
RATE_LIMIT_BATCH_PER_MIN=0
RATE_LIMIT_FONT_PER_MIN=0
