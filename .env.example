# Límites opcionales. Vacío o 0 = sin límite (por defecto, uso local).
# Copia este archivo a .env.local para aplicar los valores.

# Tamaño máximo por imagen, en MB
NEXT_PUBLIC_MAX_FILE_SIZE_MB=

# Tamaño máximo combinado de un lote, en MB
NEXT_PUBLIC_MAX_BATCH_SIZE_MB=

# Máximo de archivos por lote (por defecto 100)
NEXT_PUBLIC_MAX_FILES=100

# URL pública del sitio (Open Graph necesita una URL absoluta)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Peticiones por IP y minuto. 0 = desactivado
RATE_LIMIT_OPTIMIZE_PER_MIN=0
RATE_LIMIT_BATCH_PER_MIN=0
RATE_LIMIT_FONT_PER_MIN=0
